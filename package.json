{
  "name": "betalenttest",
  "version": "1.0.0",
  "description": "BeTalent QA Challenge — UI (Playwright) + API (Newman + k6)",
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:login": "playwright test ui/tests/specs/login.spec.ts",
    "test:ui:logout": "playwright test ui/tests/specs/logout.spec.ts",
    "test:ui:inventory": "playwright test ui/tests/specs/inventory.spec.ts",
    "test:ui:cart": "playwright test ui/tests/specs/cart.spec.ts",
    "test:ui:purchase": "playwright test ui/tests/specs/purchase-flow.spec.ts",
    "test:ui:navigation": "playwright test ui/tests/specs/navigation.spec.ts",
    "test:ui:mobile": "playwright test ui/tests/specs/responsiveness.spec.ts",
    "test:ui:a11y": "playwright test ui/tests/specs/accessibility.spec.ts",
    "test:api": "newman run api/postman/BeTalent_Booker.postman_collection.json -e api/postman/BeTalent_Booker.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export test-results/newman-report/report.html",
    "test:perf:smoke": "k6 run api/performance/k6-smoke.js",
    "test:perf:load": "k6 run api/performance/k6-load.js",
    "test:perf:stress": "k6 run api/performance/k6-stress.js",
    "test:all": "npm run test:ui && npm run test:api",
    "report": "playwright show-report test-results/playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "axe-core": "^4.10.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.5.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["ui/tests/pages/*"],
      "@data/*": ["ui/tests/data/*"],
      "@fixtures/*": ["ui/tests/fixtures/*"],
      "@helpers/*": ["ui/tests/helpers/*"]
    }
  },
  "include": ["ui/tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
